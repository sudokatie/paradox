c Tiny 2x2 Sudoku (4 cells)
c Variables: cell_row_col_value (1-indexed)
c Cell (1,1)=1: var 1, Cell (1,1)=2: var 2
c Cell (1,2)=1: var 3, Cell (1,2)=2: var 4
c Cell (2,1)=1: var 5, Cell (2,1)=2: var 6
c Cell (2,2)=1: var 7, Cell (2,2)=2: var 8
p cnf 8 20
c Each cell has at least one value
1 2 0
3 4 0
5 6 0
7 8 0
c Each cell has at most one value
-1 -2 0
-3 -4 0
-5 -6 0
-7 -8 0
c Row 1: each value appears
1 3 0
2 4 0
c Row 1: no duplicates
-1 -3 0
-2 -4 0
c Row 2: each value appears
5 7 0
6 8 0
c Row 2: no duplicates
-5 -7 0
-6 -8 0
c Column 1: no duplicates
-1 -5 0
-2 -6 0
c Column 2: no duplicates
-3 -7 0
-4 -8 0
